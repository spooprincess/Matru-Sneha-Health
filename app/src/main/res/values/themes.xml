<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.MatruSneh" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/soft_green</item>
        <item name="colorSecondary">@color/soft_green</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:textSize">16sp</item>
        <item name="android:statusBarColor">@color/white</item>
        <item name="android:navigationBarColor">@color/white</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
    </style>

    <style name="Widget.MatruSneh.BigButton" parent="Widget.Material3.Button">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">16dp</item>
    </style>

    <style name="Widget.MatruSneh.BigButtonOutlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:minHeight">56dp</item>
        <item name="android:textSize">18sp</item>
        <item name="cornerRadius">16dp</item>
    </style>

</resources>

